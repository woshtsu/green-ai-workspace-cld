{
  "uid": "green-ai-pmv2",
  "title": "Green AI · PMV2 demo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "green-ai",
    "demo"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Alcance de la demostración",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Consultas del Policy Engine, no control automático. CPU muestra la última predicción consultada (no un promedio del clúster). Energía corresponde al último periodo importado de cada procedencia; no es consumo acumulado ni ahorro. Datos de SLA aportados por el operador."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Última CPU consultada (vigencia ≤5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "green-ai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "green_ai_last_prediction_cpu_percent and (time() - green_ai_last_prediction_generated_timestamp_seconds < 300) and (green_ai_last_prediction_generated_timestamp_seconds > 0)",
          "instant": true,
          "legendFormat": "{{status}}{{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Evaluaciones por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "green-ai-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (green_ai_recommendations_total)",
          "instant": true,
          "legendFormat": "{{status}}{{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Último periodo importado (kWh, por procedencia)",
      "datasource": {
        "type": "prometheus",
        "uid": "green-ai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "green_ai_last_energy_kwh",
          "instant": true,
          "legendFormat": "{{status}}{{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Segundos desde cálculo de energía",
      "datasource": {
        "type": "prometheus",
        "uid": "green-ai-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - green_ai_last_energy_calculated_timestamp_seconds",
          "instant": true,
          "legendFormat": "{{status}}{{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    }
  ]
}

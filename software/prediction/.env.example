# Copy this file to .env if you need local overrides.
# No secrets are required to train, test or serve this component.

ML_ENV=experimental
ML_PORT=8000
ML_MODEL_DIR=models/selected
MLFLOW_TRACKING_URI=./mlruns

# Decisiones humanas sobre recomendaciones (HU-07). Registro de auditoría; no ejecuta nada.
# Disco efímero en Render: la base SQLite se pierde en cada despliegue.
DECISIONS_ENABLED=true
DECISIONS_DB_PATH=data/decisions.db

# Secreto compartido con el Gateway (H-01). Vacío = decisiones deshabilitadas (503, falla cerrado).
# El valor real solo en variables de entorno; nunca en el repositorio.
GATEWAY_SHARED_SECRET=

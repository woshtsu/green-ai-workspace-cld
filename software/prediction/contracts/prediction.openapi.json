              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/predictions": {
      "post": {
        "summary": "Create Prediction",
        "operationId": "create_prediction_v1_predictions_post",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Create Prediction V1 Predictions Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Create Prediction",
        "operationId": "create_prediction_predict_post",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Create Prediction Predict Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Check": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "Check"
      },
      "DecisionList": {
        "properties": {
          "recommendationId": {
            "type": "string",
            "title": "Recommendationid"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionResponse"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "recommendationId",
          "decisions"
        ],
        "title": "DecisionList"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/DecisionType"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "recommendation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Recommendation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "recommendation"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResponse": {
        "properties": {
          "decisionId": {
            "type": "string",
            "title": "Decisionid"
          },
          "recommendationId": {
            "type": "string",
            "title": "Recommendationid"
          },
          "decision": {
            "$ref": "#/components/schemas/DecisionType"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "decidedBy": {
            "type": "string",
            "title": "Decidedby"
          },
          "decidedByRole": {
            "$ref": "#/components/schemas/Role"
          },
          "decidedAt": {
            "type": "string",
            "title": "Decidedat"
          },
          "recommendationSha256": {
            "type": "string",
            "title": "Recommendationsha256"
          },
          "executionAllowed": {
            "type": "boolean",
            "title": "Executionallowed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "decisionId",
          "recommendationId",
          "decision",
          "comment",
          "decidedBy",
          "decidedByRole",
          "decidedAt",
          "recommendationSha256"
        ],
        "title": "DecisionResponse"
      },
      "DecisionType": {
        "type": "string",
        "enum": [
          "APPROVED",
          "REJECTED"
        ],
        "title": "DecisionType"
      },
      "EnergyRequest": {
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "observed",
              "simulated",
              "estimated"
            ],
            "title": "Origin"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/PowerSample"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 2,
            "title": "Samples"
          },
          "emissionFactorKgPerKwh": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorkgperkwh"
          },
          "emissionFactorSource": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorsource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "samples"
        ],
        "title": "EnergyRequest"
      },
      "EnergyResult": {
        "properties": {
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "energyKwh": {
            "type": "number",
            "title": "Energykwh"
          },
          "co2eKg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Co2Ekg"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "emissionFactorKgPerKwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorkgperkwh"
          },
          "emissionFactorSource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorsource"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "trapezoidal_power_integration"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "energyKwh",
          "co2eKg",
          "start",
          "end",
          "emissionFactorKgPerKwh",
          "emissionFactorSource",
          "warnings"
        ],
        "title": "EnergyResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceProblem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "InferenceProblem"
      },
      "Policy": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demonstration",
            "title": "Mode",
            "default": "demonstration"
          },
          "cpuLowPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cpulowpercent",
            "default": 30
          },
          "cpuHighPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cpuhighpercent",
            "default": 80
          },
          "memoryMaxPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Memorymaxpercent",
            "default": 85
          },
          "latencyP95MaxMs": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Latencyp95Maxms",
            "default": 500
          },
          "errorRateMaxPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Errorratemaxpercent",
            "default": 1
          },
          "freshnessSeconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Freshnessseconds",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Policy"
      },
      "PowerSample": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "watts": {
            "type": "number",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Watts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "watts"
        ],
        "title": "PowerSample"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Problem"
      },
      "Recommendation": {
        "properties": {
          "recommendationId": {
            "type": "string",
            "title": "Recommendationid"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Generatedat"
          },
          "predictionId": {
            "type": "string",
            "title": "Predictionid"
          },
          "inputDatasetId": {
            "type": "string",
            "title": "Inputdatasetid"
          },
          "predictedCpuPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Predictedcpupercent"
          },
          "telemetry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Telemetry"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_evaluable",
              "blocked",
              "eligible_for_review"
            ],
            "title": "Status"
          },
          "action": {
            "type": "string",
            "enum": [
              "none",
              "maintain",
              "review_capacity_reduction",
              "review_capacity_increase"
            ],
            "title": "Action"
          },
          "executionAllowed": {
            "type": "boolean",
            "const": false,
            "title": "Executionallowed",
            "default": false
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array",
            "title": "Checks"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendationId",
          "generatedAt",
          "predictionId",
          "inputDatasetId",
          "predictedCpuPercent",
          "telemetry",
          "resource",
          "status",
          "action",
          "policy",
          "checks",
          "warnings"
        ],
        "title": "Recommendation"
      },
      "RecommendationRequest": {
        "properties": {
          "dataset": {
            "additionalProperties": true,
            "type": "object",
            "title": "Dataset"
          },
          "telemetry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Telemetry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset"
        ],
        "title": "RecommendationRequest"
      },
      "Resource": {
        "properties": {
          "type": {
            "type": "string",
            "const": "node",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "cluster": {
            "type": "string",

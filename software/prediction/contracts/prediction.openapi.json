{
  "openapi": "3.1.0",
  "info": {
    "title": "Prediction Service",
    "description": "Internal API for short-term computational demand estimates.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/recommendations": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Recommend",
        "operationId": "recommend_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "$ref": "#/components/schemas/InferenceProblem"
                    }
                  ],
                  "title": "Response 422 Recommend V1 Recommendations Post"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/energy": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Energy",
        "operationId": "energy_v1_energy_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnergyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommendations/{recommendationId}/decisions": {
      "post": {
        "tags": [
          "Decisions"
        ],
        "summary": "Create Decision",
        "operationId": "create_decision_v1_recommendations__recommendationId__decisions_post",
        "parameters": [
          {
            "name": "recommendationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recommendationid"
            }
          },
          {
            "name": "X-Green-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-User-Id"
            }
          },
          {
            "name": "X-Green-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-User-Role"
            }
          },
          {
            "name": "X-Green-Gateway-Secret",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-Gateway-Secret"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Secreto del Gateway o cabeceras de identidad ausentes/inválidos",
            "content": {
              "application/problem+json": {}
            }
          },
          "503": {
            "description": "Falta GATEWAY_SHARED_SECRET (falla cerrado)",
            "content": {
              "application/problem+json": {}
            }
          },
          "404": {
            "description": "Decisiones desactivadas (DECISIONS_ENABLED=false)",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Parámetros o cuerpo inválidos",
            "content": {
              "application/problem+json": {}
            }
          },
          "403": {
            "description": "Rol VIEWER",
            "content": {
              "application/problem+json": {}
            }
          },
          "409": {
            "description": "Decisión duplicada del usuario",
            "content": {
              "application/problem+json": {}
            }
          }
        }
      },
      "get": {
        "tags": [
          "Decisions"
        ],
        "summary": "List Decisions",
        "operationId": "list_decisions_v1_recommendations__recommendationId__decisions_get",
        "parameters": [
          {
            "name": "recommendationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recommendationid"
            }
          },
          {
            "name": "X-Green-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-User-Id"
            }
          },
          {
            "name": "X-Green-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-User-Role"
            }
          },
          {
            "name": "X-Green-Gateway-Secret",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Green-Gateway-Secret"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionList"
                }
              }
            }
          },
          "401": {
            "description": "Secreto del Gateway o cabeceras de identidad ausentes/inválidos",
            "content": {
              "application/problem+json": {}
            }
          },
          "503": {
            "description": "Falta GATEWAY_SHARED_SECRET (falla cerrado)",
            "content": {
              "application/problem+json": {}
            }
          },
          "404": {
            "description": "Decisiones desactivadas (DECISIONS_ENABLED=false)",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Parámetros o cuerpo inválidos",
            "content": {
              "application/problem+json": {}
            }
          }
        }
      }
    },
    "/health": {

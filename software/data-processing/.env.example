# ==========================================
# GREEN AI - DATA PROCESSING SERVICE
# ==========================================

# Monitoring Service
# URL usada cuando los microservicios se ejecutan mediante Docker
MONITORING_BASE_URL=http://monitoring:8080

# Docker escucha en 0.0.0.0:8000; estas opciones se fijan en el CMD.

# Tiempo máximo de espera para llamadas HTTP
REQUEST_TIMEOUT_SECONDS=10

# Históricos mediante Supabase Data API (solo lectura; deshabilitado por defecto).
# Configurar un JWT de servidor dedicado con permisos mínimos de SELECT sobre logs.
# No usar el JWT del usuario ni asumir que una API key concede permisos mínimos.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_READ_TOKEN=
HISTORICAL_MAX_PAGE_SIZE=500

# Selección de la fuente de históricos: none | supabase | sqlite.
# Vacío = compatibilidad: supabase si SUPABASE_ENABLED=true, si no none.
HISTORICAL_SOURCE=
# Entorno: development | test | production (por defecto production).
# sqlite SOLO con development/test: no replica Auth, RLS ni procedimientos de Supabase.
APP_ENV=production
# Ruta a la base creada con scripts/seed_sqlite.py (solo HISTORICAL_SOURCE=sqlite).
SQLITE_PATH=
